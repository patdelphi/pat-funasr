# 精细转录 LLM 配置
# 复制本文件为 .env 并填入实际值
# 格式: LLM_<索引>_<字段>=值
# 一个 provider 可配置多个 model，用逗号分隔
# enabled=true/false 控制是否在前端显示

# === 本地 Ollama ===
LLM_1_NAME=Ollama 本地
LLM_1_PROVIDER=ollama
LLM_1_BASE_URL=http://127.0.0.1:11434/v1
LLM_1_API_KEY=no-key
LLM_1_MODELS=qwen2.5:7b,qwen2.5:14b,llama3.1:8b
LLM_1_ENABLED=true

# === OpenAI 在线 ===
LLM_2_NAME=OpenAI
LLM_2_PROVIDER=openai
LLM_2_BASE_URL=https://api.openai.com/v1
LLM_2_API_KEY=sk-your-openai-api-key
LLM_2_MODELS=gpt-4o-mini,gpt-4o
LLM_2_ENABLED=false

# === Claude 在线 ===
LLM_3_NAME=Claude
LLM_3_PROVIDER=claude
LLM_3_BASE_URL=https://api.anthropic.com/v1
LLM_3_API_KEY=your-claude-api-key
LLM_3_MODELS=claude-3-haiku-20240307,claude-3-sonnet-20240229
LLM_3_ENABLED=false

# === 自定义兼容接口(如 vLLM/LocalAI) ===
LLM_4_NAME=自定义
LLM_4_PROVIDER=custom
LLM_4_BASE_URL=http://127.0.0.1:8080/v1
LLM_4_API_KEY=no-key
LLM_4_MODELS=
LLM_4_ENABLED=false
